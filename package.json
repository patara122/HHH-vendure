    "@vendure-community/stripe-plugin": "^1.0.0",
    "@vendure/asset-server-plugin": "^3.6.2",
    "@vendure/core": "3.6.2",
    "@vendure/dashboard": "3.6.2",
    "@vendure/email-plugin": "3.6.2",
    "@vendure/graphiql-plugin": "3.6.2",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "stripe": "^13.11.0"
  },
  "devDependencies": {
    "@vendure/cli": "3.6.2",
    "@vendure/create": "^3.6.2",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "9.2.1",
    "typescript": "5.8.2"
